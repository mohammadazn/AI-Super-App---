# Server
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-super-app
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
FRONTEND_URL=http://localhost:5173

# Admin
ADMIN_API_KEY=CHANGE_ME

# Identity / KYC
# تا زمان گرفتن مجوز، true بماند.
IDENTITY_MOCK_MODE=true

# Provider: paystar | finnotech | custom
IDENTITY_PROVIDER=paystar

# فعلاً false بماند؛ بعد از گرفتن قرارداد و API Key فعال می‌شود.
SHAHKAR_ENABLED=false
IDENTITY_INQUIRY_ENABLED=false

# PayStar
PAYSTAR_APPLICATION_ID=
PAYSTAR_ACCESS_PASSWORD=
PAYSTAR_API_KEY=

# شاهکار Lite
PAYSTAR_SHAHKAR_URL=https://core.paystar.ir/api/open-banking/service/info-matching/mobile-national-id

# این آدرس را فقط بعد از دریافت مستندات Provider وارد کن.
PAYSTAR_IDENTITY_INQUIRY_URL=

# Encryption
# خروجی دستور ساخت کلید 32 بایتی Base64 را اینجا قرار بده
KYC_ENCRYPTION_KEY=BASE64_32_BYTE_KEY_HERE

# Versioning
KYC_POLICY_VERSION=2026-01
KYC_MAX_FILE_SIZE_MB=10

# SMS - Kavenegar (کاوه نگار)
KAVENEGAR_API_KEY=your-kavenegar-api-key

# AI APIs
GROQ_KEY=gsk_your-groq-api-key
GEMINI_KEY=your-gemini-api-key
REPLICATE_KEY=r8_your-replicate-key
WIREFLOW_KEY=your-wireflow-key

# Crypto - Binance
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET=your-binance-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Auto-Recharge Settings
AUTO_RECHARGE_ENABLED=true
AUTO_RECHARGE_TRIGGER_BALANCE=10
AUTO_RECHARGE_AMOUNT=50

# Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ADMIN_CHAT_ID=your-chat-id

# Dollar Rate (Toman)
USD_RATE=60000
# ==========================================
# Identity Verification / KYC
# ==========================================

# تا زمان گرفتن قرارداد و مجوز، true بماند.
# در این حالت هیچ استعلام واقعی ارسال نمی‌شود.
IDENTITY_MOCK_MODE=true

# Provider: paystar | finnotech | custom
IDENTITY_PROVIDER=paystar

# شاهکار Lite: تطبیق شماره موبایل با کد ملی
SHAHKAR_ENABLED=false

# استعلام مشخصات هویتی
IDENTITY_INQUIRY_ENABLED=false

# PayStar - فقط بعد از دریافت دسترسی واقعی
PAYSTAR_APPLICATION_ID=
PAYSTAR_ACCESS_PASSWORD=
PAYSTAR_API_KEY=
PAYSTAR_REFRESH_TOKEN=

# FinoTech - فقط بعد از دریافت دسترسی واقعی
FINNOTECH_BASE_URL=
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_SCOPE=facility:shahkar:get

# Encryption
# یک کلید ۳۲ بایتی Base64 برای رمزنگاری اطلاعات KYC
KYC_ENCRYPTION_KEY=
KYC_POLICY_VERSION=2026-01

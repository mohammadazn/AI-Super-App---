# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/ai-super-app?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMS - Kavenegar (کاوه نگار)
KAVENEGAR_API_KEY=your-kavenegar-api-key

# AI APIs
GROQ_KEY=gsk_your-groq-api-key
GEMINI_KEY=your-gemini-api-key
REPLICATE_KEY=r8_your-replicate-key
WIREFLOW_KEY=your-wireflow-key

# Crypto - Binance
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET=your-binance-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Auto-Recharge Settings
AUTO_RECHARGE_ENABLED=true
AUTO_RECHARGE_TRIGGER_BALANCE=10
AUTO_RECHARGE_AMOUNT=50

# Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
ADMIN_CHAT_ID=your-chat-id

# Dollar Rate (Toman)
USD_RATE=60000
